<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<c:set var="pageTitle" value="${empty document.id ? 'Novo documento' : 'Editar documento'}" scope="request"/><jsp:include page="../fragments/header.jsp"/>
<div class="page-heading"><div><p class="eyebrow">Editor documental</p><h1>${empty document.id ? 'Novo documento' : document.title}</h1><p>Controle de conteúdo e revisão para procedimentos industriais.</p></div><c:if test="${not empty document.id}"><a class="btn btn-dark" href="<c:url value='/documentos/${document.id}/word'/>">Baixar Word</a></c:if></div>
<form class="form-card" action="<c:url value='/documentos/salvar'/>" method="post"><input type="hidden" name="id" value="${document.id}"><input type="hidden" name="version" value="${document.version}"><input type="hidden" name="revision" value="${document.revision}">
<div class="form-section"><h2>Identificação e controle</h2><div class="form-grid"><div class="field"><label>Código *</label><input name="code" value="${document.code}" required placeholder="PO-ACI-001"></div><div class="field"><label>Título *</label><input name="title" value="${document.title}" required></div><div class="field"><label>Categoria *</label><select name="category"><option>Procedimento operacional</option><option>Instrução de trabalho</option><option>Norma interna</option><option>Formulário</option><option>Plano de emergência</option></select></div><div class="field"><label>Status</label><select name="status"><c:forEach items="${statuses}" var="s"><option value="${s}" ${document.status == s ? 'selected' : ''}>${s.label}</option></c:forEach></select></div><div class="field"><label>Responsável</label><select name="owner.id"><option value="">Selecione</option><c:forEach items="${users}" var="u"><option value="${u.id}" ${document.owner.id == u.id ? 'selected' : ''}>${u.name}</option></c:forEach></select></div><c:if test="${not empty document.id}"><div class="field"><label>Motivo da alteração</label><input name="changeReason" required placeholder="Descreva o que mudou"></div></c:if></div></div>
<div class="form-section"><h2>Conteúdo</h2><div class="field"><label>Texto do documento *</label><textarea id="document-content" name="content" style="min-height:330px" required>${document.content}</textarea><div class="help" id="document-counter"></div></div></div>
<div class="form-actions"><a class="btn btn-secondary" href="<c:url value='/documentos'/>">Cancelar</a><button class="btn btn-primary">Salvar revisão</button></div></form>
<c:if test="${not empty revisions}"><section class="panel table-panel"><div class="panel-head"><div><h2>Histórico de revisões</h2></div></div><table class="data"><thead><tr><th>Revisão</th><th>Data</th><th>Motivo</th><th>Editor</th></tr></thead><tbody><c:forEach items="${revisions}" var="r"><tr><td>Rev. ${r.revisionNumber}</td><td><fmt:formatDate value="${r.createdAt}" pattern="dd/MM/yyyy HH:mm"/></td><td>${r.changeReason}</td><td>${empty r.changedBy ? 'Sistema' : r.changedBy.name}</td></tr></c:forEach></tbody></table></section></c:if>
<jsp:include page="../fragments/footer.jsp"/>