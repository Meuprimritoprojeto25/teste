<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<c:set var="pageTitle" value="Documentos" scope="request"/><jsp:include page="../fragments/header.jsp"/>
<div class="page-heading"><div><p class="eyebrow">Gestão documental</p><h1>Procedimentos e documentos</h1><p>Criação, edição, histórico de revisões e geração em Word.</p></div><a class="btn btn-primary" href="<c:url value='/documentos/novo'/>">+ Novo documento</a></div>
<section class="panel"><div class="table-scroll"><table class="data"><thead><tr><th>Código</th><th>Título</th><th>Categoria</th><th>Revisão</th><th>Status</th><th>Responsável</th><th>Atualizado</th><th></th></tr></thead><tbody><c:forEach items="${documents}" var="d"><tr><td class="code">${d.code}</td><td><strong>${d.title}</strong></td><td>${d.category}</td><td>Rev. ${d.revision}</td><td><span class="badge badge-${d.status}">${d.status.label}</span></td><td>${empty d.owner ? '—' : d.owner.name}</td><td><fmt:formatDate value="${d.updatedAt}" pattern="dd/MM/yyyy HH:mm"/></td><td><div class="actions"><a class="btn btn-secondary btn-small" href="<c:url value='/documentos/${d.id}/editar'/>">Editar</a><a class="btn btn-dark btn-small" href="<c:url value='/documentos/${d.id}/word'/>">Word</a></div></td></tr></c:forEach><c:if test="${empty documents}"><tr><td colspan="8" class="empty">Nenhum documento cadastrado.</td></tr></c:if></tbody></table></div></section>
<jsp:include page="../fragments/footer.jsp"/>