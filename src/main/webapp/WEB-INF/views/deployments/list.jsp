<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="pageTitle" value="Desdobramentos" scope="request"/><jsp:include page="../fragments/header.jsp"/>
<div class="page-heading"><div><p class="eyebrow">Árvore de resultados</p><h1>Desdobramento de metas</h1><p>Conecte indicadores estratégicos aos direcionadores operacionais.</p></div><a class="btn btn-primary" href="<c:url value='/desdobramentos/novo'/>">+ Novo vínculo</a></div>
<section class="panel"><div class="table-scroll"><table class="data"><thead><tr><th>Indicador pai</th><th></th><th>Indicador desdobrado</th><th>Peso</th><th>Justificativa</th><th>Situação</th></tr></thead><tbody><c:forEach items="${deployments}" var="d"><tr><td><span class="code">${d.parentItem.code}</span><br><strong>${d.parentItem.name}</strong></td><td style="color:var(--accent)">→</td><td><span class="code">${d.childItem.code}</span><br><strong>${d.childItem.name}</strong></td><td>${d.weight}%</td><td>${d.rationale}</td><td><span class="badge badge-${d.active ? 'GREEN' : 'GRAY'}">${d.active ? 'Ativo' : 'Inativo'}</span></td></tr></c:forEach><c:if test="${empty deployments}"><tr><td colspan="6" class="empty">Nenhum desdobramento criado.</td></tr></c:if></tbody></table></div></section>
<jsp:include page="../fragments/footer.jsp"/>