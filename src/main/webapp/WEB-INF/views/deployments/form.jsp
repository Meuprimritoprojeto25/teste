<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="pageTitle" value="Novo desdobramento" scope="request"/><jsp:include page="../fragments/header.jsp"/>
<div class="page-heading"><div><p class="eyebrow">Árvore de metas</p><h1>Novo desdobramento</h1><p>A regra impede autorreferência, ciclos diretos e pesos inválidos.</p></div></div>
<form class="form-card" action="<c:url value='/desdobramentos/salvar'/>" method="post"><div class="form-section"><h2>Relação entre indicadores</h2><div class="form-grid"><div class="field"><label>Indicador pai *</label><select name="parentItem.id" required><option value="">Selecione</option><c:forEach items="${items}" var="i"><option value="${i.id}">${i.code} — ${i.name}</option></c:forEach></select></div><div class="field"><label>Indicador filho *</label><select name="childItem.id" required><option value="">Selecione</option><c:forEach items="${items}" var="i"><option value="${i.id}">${i.code} — ${i.name}</option></c:forEach></select></div><div class="field"><label>Peso no resultado (%) *</label><input type="number" name="weight" min="0.01" max="100" step=".01" required></div><div class="field full"><label>Justificativa do desdobramento</label><textarea name="rationale"></textarea></div><div class="field"><label class="check"><input type="checkbox" name="active" value="true" checked> Vínculo ativo</label></div></div></div><div class="form-actions"><a class="btn btn-secondary" href="<c:url value='/desdobramentos'/>">Cancelar</a><button class="btn btn-primary">Criar vínculo</button></div></form>
<jsp:include page="../fragments/footer.jsp"/>