<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<c:set var="pageTitle" value="Relatórios R3G" scope="request"/><jsp:include page="../fragments/header.jsp"/>
<div class="page-heading"><div><p class="eyebrow">Resultado, gaps e ganhos</p><h1>Relatórios R3G</h1><p>Memória estruturada das reuniões de resultado.</p></div><a class="btn btn-primary" href="<c:url value='/r3g/novo'/>">+ Novo R3G</a></div>
<section class="panel"><div class="table-scroll"><table class="data"><thead><tr><th>Referência</th><th>Título</th><th>Área</th><th>Autor</th><th>Status</th><th>Revisão</th><th></th></tr></thead><tbody><c:forEach items="${reports}" var="r"><tr><td><fmt:formatDate value="${r.referenceDate}" pattern="MM/yyyy"/></td><td><strong>${r.title}</strong><br><small>${r.resultSummary}</small></td><td>${r.area}</td><td>${empty r.author ? '—' : r.author.name}</td><td><span class="badge badge-${r.status}">${r.status.label}</span></td><td>v${r.version + 1}</td><td><div class="actions"><a class="btn btn-secondary btn-small" href="<c:url value='/r3g/${r.id}/editar'/>">Editar</a><a class="btn btn-dark btn-small" href="<c:url value='/r3g/${r.id}/word'/>">Word</a><a class="btn btn-dark btn-small" href="<c:url value='/r3g/${r.id}/pdf'/>">PDF</a><a class="btn btn-dark btn-small" href="<c:url value='/r3g/${r.id}/excel'/>">Excel</a></div></td></tr></c:forEach><c:if test="${empty reports}"><tr><td colspan="7" class="empty">Nenhum R3G registrado.</td></tr></c:if></tbody></table></div></section>
<jsp:include page="../fragments/footer.jsp"/>