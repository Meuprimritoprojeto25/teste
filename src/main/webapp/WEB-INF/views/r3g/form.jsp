<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<c:set var="pageTitle" value="${empty report.id ? 'Novo R3G' : 'Editar R3G'}" scope="request"/><jsp:include page="../fragments/header.jsp"/>
<div class="page-heading"><div><p class="eyebrow">Ritual de gestão</p><h1>${empty report.id ? 'Novo relatório R3G' : report.title}</h1><p>Consolide resultado, gaps, ganhos e próximos passos.</p></div></div>
<form class="form-card" action="<c:url value='/r3g/salvar'/>" method="post"><input type="hidden" name="id" value="${report.id}"><input type="hidden" name="version" value="${report.version}"><div class="form-section"><h2>Identificação</h2><div class="form-grid"><div class="field"><label>Título *</label><input name="title" value="${report.title}" required></div><div class="field"><label>Área *</label><input name="area" value="${report.area}" required></div><div class="field"><label>Referência *</label><input type="date" name="referenceDate" value="<fmt:formatDate value='${report.referenceDate}' pattern='yyyy-MM-dd'/>" required></div><div class="field"><label>Autor</label><select name="author.id"><option value="">Selecione</option><c:forEach items="${users}" var="u"><option value="${u.id}" ${report.author.id == u.id ? 'selected' : ''}>${u.name}</option></c:forEach></select></div><div class="field"><label>Status</label><select name="status"><c:forEach items="${statuses}" var="s"><option value="${s}" ${report.status == s ? 'selected' : ''}>${s.label}</option></c:forEach></select></div></div></div>
<div class="form-section"><h2>Análise R3G</h2><div class="form-grid"><div class="field full"><label>Resultado *</label><textarea name="resultSummary" required>${report.resultSummary}</textarea></div><div class="field"><label>Gaps</label><textarea name="gaps">${report.gaps}</textarea></div><div class="field"><label>Ganhos</label><textarea name="gains">${report.gains}</textarea></div><div class="field full"><label>Próximos passos</label><textarea name="nextSteps">${report.nextSteps}</textarea></div></div></div><div class="form-actions"><a class="btn btn-secondary" href="<c:url value='/r3g'/>">Cancelar</a><button class="btn btn-primary">Salvar R3G</button></div></form>
<jsp:include page="../fragments/footer.jsp"/>