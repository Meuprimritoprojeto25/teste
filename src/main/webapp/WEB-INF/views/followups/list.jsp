<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<c:set var="pageTitle" value="Farol e acompanhamento" scope="request"/><jsp:include page="../fragments/header.jsp"/>
<div class="page-heading"><div><p class="eyebrow">Rotina gerencial</p><h1>Farol &amp; acompanhamento</h1><p>Histórico de resultados, causas e ações corretivas.</p></div><div class="actions"><a class="btn btn-secondary" href="<c:url value='/relatorios'/>">Exportar</a><a class="btn btn-primary" href="<c:url value='/acompanhamentos/novo'/>">+ Novo apontamento</a></div></div>
<section class="metrics"><article class="metric"><div class="metric-top">Superados</div><div class="metric-value" style="color:var(--blue)">${lights['BLUE']}</div></article><article class="metric"><div class="metric-top">No alvo</div><div class="metric-value" style="color:var(--green)">${lights['GREEN']}</div></article><article class="metric"><div class="metric-top">Atenção</div><div class="metric-value" style="color:var(--yellow)">${lights['YELLOW']}</div></article><article class="metric"><div class="metric-top">Críticos</div><div class="metric-value" style="color:var(--red)">${lights['RED']}</div></article></section>
<section class="panel"><div class="table-scroll"><table class="data"><thead><tr><th>Referência</th><th>Item de controle</th><th>Meta</th><th>Realizado</th><th>Farol</th><th>Análise / causa</th><th>Plano de ação</th></tr></thead><tbody>
<c:forEach items="${followUps}" var="row"><tr><td><fmt:formatDate value="${row.referenceDate}" pattern="dd/MM/yyyy"/></td><td><span class="code">${row.item.code}</span><br><strong>${row.item.name}</strong></td><td>${row.item.target} ${row.item.unit}</td><td><strong>${row.actualValue}</strong> ${row.item.unit}</td><td><span class="badge badge-${row.status}">${row.status.label}</span></td><td>${empty row.analysis ? row.rootCause : row.analysis}</td><td>${row.actionPlan}</td></tr></c:forEach><c:if test="${empty followUps}"><tr><td colspan="7" class="empty">Nenhum resultado apontado.</td></tr></c:if>
</tbody></table></div></section><jsp:include page="../fragments/footer.jsp"/>