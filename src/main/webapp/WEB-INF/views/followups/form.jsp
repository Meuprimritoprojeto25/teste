<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<c:set var="pageTitle" value="Novo apontamento" scope="request"/><jsp:include page="../fragments/header.jsp"/>
<div class="page-heading"><div><p class="eyebrow">Acompanhamento</p><h1>Registrar resultado</h1><p>O farol e o atingimento do KPI serão calculados pelas regras do item.</p></div></div>
<form class="form-card" action="<c:url value='/acompanhamentos/salvar'/>" method="post"><div class="form-section"><h2>Resultado medido</h2><div class="form-grid">
<div class="field full"><label>Item de controle *</label><select name="item.id" required><option value="">Selecione</option><c:forEach items="${items}" var="i"><option value="${i.id}">${i.code} — ${i.name} (meta ${i.target} ${i.unit})</option></c:forEach></select></div>
<div class="field"><label>Data de referência *</label><input type="date" name="referenceDate" value="<fmt:formatDate value='${followUp.referenceDate}' pattern='yyyy-MM-dd'/>" required></div><div class="field"><label>Valor realizado *</label><input type="number" step="any" name="actualValue" required></div>
</div></div><div class="form-section"><h2>Análise e contramedida</h2><div class="form-grid"><div class="field full"><label>Análise do resultado</label><textarea name="analysis" placeholder="Explique o comportamento observado..."></textarea></div><div class="field"><label>Causa raiz</label><textarea name="rootCause"></textarea></div><div class="field"><label>Plano de ação</label><textarea name="actionPlan" placeholder="Ação, responsável e prazo..."></textarea></div></div></div>
<div class="form-actions"><a class="btn btn-secondary" href="<c:url value='/acompanhamentos'/>">Cancelar</a><button class="btn btn-primary">Calcular e registrar</button></div></form><jsp:include page="../fragments/footer.jsp"/>