<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<c:set var="pageTitle" value="Produção siderúrgica" scope="request"/><jsp:include page="../fragments/header.jsp"/>
<div class="page-heading"><div><p class="eyebrow">Operação</p><h1>Produção siderúrgica</h1><p>Apontamento de turnos, carga metálica, energia e qualidade.</p></div><a class="btn btn-primary" href="<c:url value='/producao/novo'/>">+ Apontar turno</a></div>
<c:if test="${not empty totals}"><section class="metrics"><c:forEach items="${totals}" var="total"><article class="metric"><div class="metric-top"><span>${total[0]}</span><span class="metric-icon">◆</span></div><div class="metric-value"><fmt:formatNumber value="${total[1]}" maxFractionDigits="0"/> t</div><div class="metric-foot">qualidade média <fmt:formatNumber value="${total[2]}" maxFractionDigits="1"/>%</div></article></c:forEach></section></c:if>
<section class="panel"><div class="table-scroll"><table class="data"><thead><tr><th>Data</th><th>Planta / forno</th><th>Turno</th><th>Produção</th><th>Minério</th><th>Sucata</th><th>Energia</th><th>Qualidade</th><th>Parada</th></tr></thead><tbody><c:forEach items="${records}" var="r"><tr><td><fmt:formatDate value="${r.productionDate}" pattern="dd/MM/yyyy"/></td><td><strong>${r.plant}</strong><br><span class="code">${r.furnace}</span></td><td>${r.shift}</td><td><strong>${r.producedTons} t</strong></td><td>${r.oreTons} t</td><td>${r.scrapTons} t</td><td>${r.energyMwh} MWh</td><td>${r.qualityIndex}%</td><td>${r.downtimeMinutes} min</td></tr></c:forEach><c:if test="${empty records}"><tr><td colspan="9" class="empty">Nenhum turno de produção apontado.</td></tr></c:if></tbody></table></div></section>
<jsp:include page="../fragments/footer.jsp"/>