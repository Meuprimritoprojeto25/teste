<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<c:set var="pageTitle" value="Apontar produção" scope="request"/><jsp:include page="../fragments/header.jsp"/>
<div class="page-heading"><div><p class="eyebrow">Chão de fábrica</p><h1>Apontamento de turno</h1><p>Registre volume, insumos e desempenho operacional.</p></div></div>
<form class="form-card" action="<c:url value='/producao/salvar'/>" method="post"><div class="form-section"><h2>Identificação do turno</h2><div class="form-grid"><div class="field"><label>Data *</label><input type="date" name="productionDate" value="<fmt:formatDate value='${record.productionDate}' pattern='yyyy-MM-dd'/>" required></div><div class="field"><label>Planta *</label><select name="plant"><option>Usina Sudeste</option><option>Usina Norte</option><option>Unidade de Pelotização</option></select></div><div class="field"><label>Forno / linha *</label><input name="furnace" required placeholder="Alto-forno 01"></div><div class="field"><label>Turno *</label><select name="shift"><option>A — 06h às 14h</option><option>B — 14h às 22h</option><option>C — 22h às 06h</option></select></div></div></div>
<div class="form-section"><h2>Balanço operacional</h2><div class="form-grid"><div class="field"><label>Produção (t) *</label><input type="number" step=".01" min="0" name="producedTons" required></div><div class="field"><label>Minério / gusa (t)</label><input type="number" step=".01" min="0" name="oreTons"></div><div class="field"><label>Sucata (t)</label><input type="number" step=".01" min="0" name="scrapTons"></div><div class="field"><label>Energia (MWh)</label><input type="number" step=".01" min="0" name="energyMwh"></div><div class="field"><label>Índice de qualidade (%)</label><input type="number" step=".01" min="0" max="100" name="qualityIndex"></div><div class="field"><label>Tempo de parada (min)</label><input type="number" min="0" name="downtimeMinutes"></div><div class="field full"><label>Ocorrências do turno</label><textarea name="notes"></textarea></div></div></div><div class="form-actions"><a class="btn btn-secondary" href="<c:url value='/producao'/>">Cancelar</a><button class="btn btn-primary">Registrar turno</button></div></form>
<jsp:include page="../fragments/footer.jsp"/>