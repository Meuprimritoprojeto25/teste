<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="pageTitle" value="Registrar treinamento" scope="request"/><jsp:include page="../fragments/header.jsp"/>
<div class="page-heading"><div><p class="eyebrow">Capacitação</p><h1>Registrar treinamento</h1><p>A aprovação é calculada pela nota e a validade alimenta os alertas.</p></div></div>
<form class="form-card" action="<c:url value='/treinamentos/salvar'/>" method="post"><div class="form-section"><h2>Treinamento realizado</h2><div class="form-grid"><div class="field full"><label>Motorista *</label><select name="driver.id" required><option value="">Selecione</option><c:forEach items="${drivers}" var="d"><option value="${d.id}">${d.registration} — ${d.name} / CNH ${d.licenseCategory}</option></c:forEach></select></div><div class="field"><label>Curso *</label><input name="course" required placeholder="Direção defensiva"></div><div class="field"><label>Instrutor</label><input name="instructor"></div><div class="field"><label>Conclusão *</label><input type="date" name="completionDate" required></div><div class="field"><label>Validade *</label><input type="date" name="expirationDate" required></div><div class="field"><label>Carga horária</label><input type="number" name="workloadHours" min="1"></div><div class="field"><label>Nota (0–100)</label><input type="number" name="score" min="0" max="100" step=".1"></div></div></div><div class="form-actions"><a class="btn btn-secondary" href="<c:url value='/treinamentos'/>">Cancelar</a><button class="btn btn-primary">Registrar treinamento</button></div></form>
<jsp:include page="../fragments/footer.jsp"/>