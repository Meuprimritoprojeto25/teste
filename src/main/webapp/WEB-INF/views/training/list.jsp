<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<c:set var="pageTitle" value="Treinamento de motoristas" scope="request"/><jsp:include page="../fragments/header.jsp"/>
<div class="page-heading"><div><p class="eyebrow">Segurança logística</p><h1>Treinamento de motoristas</h1><p>Habilitações, capacitações e vencimentos da frota interna.</p></div><div class="actions"><a class="btn btn-secondary" href="<c:url value='/treinamentos/motorista/novo'/>">Cadastrar motorista</a><a class="btn btn-primary" href="<c:url value='/treinamentos/novo'/>">+ Registrar treinamento</a></div></div>
<c:if test="${not empty expiring}"><div class="flash" style="border-color:var(--yellow);background:#fff8e5"><strong>Atenção:</strong> ${expiring.size()} treinamento(s) vencidos ou com vencimento nos próximos 60 dias.</div></c:if>
<section class="panel"><div class="panel-head"><div><h2>Capacitações</h2><div class="panel-subtitle">Aprovação automática para notas a partir de 70</div></div></div><div class="table-scroll"><table class="data"><thead><tr><th>Motorista</th><th>Matrícula / CNH</th><th>Treinamento</th><th>Conclusão</th><th>Validade</th><th>Carga</th><th>Nota</th><th>Resultado</th></tr></thead><tbody>
<c:forEach items="${trainings}" var="t"><tr><td><strong>${t.driver.name}</strong></td><td>${t.driver.registration}<br><span class="code">${t.driver.licenseCategory} · ${t.driver.licenseNumber}</span></td><td>${t.course}<br><small>${t.instructor}</small></td><td><fmt:formatDate value="${t.completionDate}" pattern="dd/MM/yyyy"/></td><td><fmt:formatDate value="${t.expirationDate}" pattern="dd/MM/yyyy"/></td><td>${t.workloadHours}h</td><td>${t.score}</td><td><span class="badge badge-${t.approved ? 'GREEN' : 'RED'}">${t.approved ? 'Aprovado' : 'Pendente'}</span></td></tr></c:forEach><c:if test="${empty trainings}"><tr><td colspan="8" class="empty">Nenhum treinamento registrado.</td></tr></c:if>
</tbody></table></div></section>
<section class="panel table-panel"><div class="panel-head"><div><h2>Motoristas cadastrados</h2></div></div><div class="table-scroll"><table class="data"><thead><tr><th>Matrícula</th><th>Nome</th><th>CPF</th><th>CNH</th><th>Categoria</th><th>Situação</th></tr></thead><tbody><c:forEach items="${drivers}" var="d"><tr><td class="code">${d.registration}</td><td>${d.name}</td><td>${d.cpf}</td><td>${d.licenseNumber}</td><td>${d.licenseCategory}</td><td><span class="badge badge-${d.active ? 'GREEN' : 'GRAY'}">${d.active ? 'Ativo' : 'Inativo'}</span></td></tr></c:forEach></tbody></table></div></section>
<jsp:include page="../fragments/footer.jsp"/>