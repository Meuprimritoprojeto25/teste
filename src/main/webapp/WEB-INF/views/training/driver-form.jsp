<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="pageTitle" value="Cadastrar motorista" scope="request"/><jsp:include page="../fragments/header.jsp"/>
<div class="page-heading"><div><p class="eyebrow">Segurança logística</p><h1>Novo motorista</h1><p>Cadastro funcional e dados da habilitação.</p></div></div>
<form class="form-card" action="<c:url value='/treinamentos/motorista/salvar'/>" method="post"><div class="form-section"><h2>Dados do motorista</h2><div class="form-grid"><div class="field"><label>Nome completo *</label><input name="name" required></div><div class="field"><label>Matrícula *</label><input name="registration" required></div><div class="field"><label>CPF</label><input name="cpf" placeholder="000.000.000-00"></div><div class="field"><label>Número da CNH</label><input name="licenseNumber"></div><div class="field"><label>Categoria</label><select name="licenseCategory"><option>B</option><option>C</option><option>D</option><option>E</option><option>AE</option></select></div><div class="field"><label class="check"><input type="checkbox" name="active" value="true" checked> Motorista ativo</label></div></div></div><div class="form-actions"><a class="btn btn-secondary" href="<c:url value='/treinamentos'/>">Cancelar</a><button class="btn btn-primary">Cadastrar motorista</button></div></form>
<jsp:include page="../fragments/footer.jsp"/>