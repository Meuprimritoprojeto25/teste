<%@ include file="../common/header.jsp" %>
<div class="breadcrumb">CADASTROS / USUÁRIOS</div><div class="title-line"><div><h1>Usuários e perfis</h1><p class="hint">Controle de acesso aos módulos gerenciais</p></div><a class="button" href="${pageContext.request.contextPath}/usuarios/novo">Novo usuário</a></div>
<div class="panel"><div class="panel-body"><input id="userFilter" onkeyup="filterTable('userFilter','usersTable')" placeholder="Pesquisar usuário..." style="margin-bottom:12px;padding:8px;width:280px;border:1px solid #bdcbd0"><table id="usersTable"><thead><tr><th>Nome</th><th>Login</th><th>E-mail</th><th>Perfil</th><th>Status</th></tr></thead><tbody><c:forEach items="${users}" var="u"><tr><td>${u.name}</td><td>${u.login}</td><td>${u.email}</td><td>${u.role}</td><td><span class="status ${u.active ? 'VIGENTE' : 'VENCIDO'}">${u.active ? 'ATIVO' : 'INATIVO'}</span></td></tr></c:forEach><c:if test="${empty users}"><tr><td class="empty" colspan="5">Nenhum usuário cadastrado.</td></tr></c:if></tbody></table></div></div>
<%@ include file="../common/footer.jsp" %>