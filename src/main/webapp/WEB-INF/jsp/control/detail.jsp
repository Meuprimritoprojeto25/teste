<%@ include file="../common/header.jsp" %>
<div class="breadcrumb">GESTÃO / ITENS DE CONTROLE / ${item.code}</div><div class="title-line"><div><h1>${item.name}</h1><p class="hint">${item.code} • ${item.area} • Responsável: ${item.owner}</p></div><span class="status ${item.trafficColor}">${item.trafficColor}</span></div>
<section class="columns"><div><div class="panel"><div class="panel-title"><h2>Leitura e farol</h2></div><div class="panel-body"><table><tr><th>Meta</th><td>${item.target}</td><th>Atual</th><td>${item.currentValue}</td></tr><tr><th>Amarelo</th><td>${item.warningLimit}</td><th>Crítico</th><td>${item.criticalLimit}</td></tr></table><form style="margin-top:18px" method="post" action="${pageContext.request.contextPath}/itens-controle/${item.id}/leitura"><label>Registrar nova leitura: </label><input type="number" step="0.01" name="value" required><button class="button">Atualizar farol</button></form></div></div><div class="panel" style="margin-top:16px"><div class="panel-title"><h2>Acompanhamento</h2></div><div class="panel-body"><form method="post" action="${pageContext.request.contextPath}/itens-controle/${item.id}/acompanhamento"><div class="field"><label>Registro / evidência</label><textarea name="note" required></textarea></div><div class="field" style="margin-top:10px"><label>Autor</label><input name="author" required></div><div class="form-actions"><button class="button">Registrar acompanhamento</button></div></form></div></div></div><div class="panel"><div class="panel-title"><h2>Histórico</h2></div><div class="panel-body"><ul class="timeline"><c:forEach items="${followUps}" var="f"><li><small>${f.registeredAt} • ${f.author}</small>${f.note}</li></c:forEach><c:if test="${empty followUps}"><li>Sem registros de acompanhamento.</li></c:if></ul></div></div></section>
