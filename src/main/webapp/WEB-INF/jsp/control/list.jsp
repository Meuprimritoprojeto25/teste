<%@ include file="../common/header.jsp" %>
<div class="breadcrumb">GESTÃO / ITENS DE CONTROLE</div><div class="title-line"><div><h1>Itens de controle</h1><p class="hint">KPIs operacionais acompanhados pelo sistema de farol.</p></div><a class="button" href="${pageContext.request.contextPath}/itens-controle/novo">Novo item</a></div>
<div class="panel"><div class="panel-body"><input id="controlFilter" onkeyup="filterTable('controlFilter','controlsTable')" placeholder="Filtrar por código, área ou item..." style="margin-bottom:12px;padding:8px;width:300px;border:1px solid #bdcbd0"><table id="controlsTable"><thead><tr><th>Código</th><th>Indicador</th><th>Área</th><th>Responsável</th><th>Meta</th><th>Atual</th><th>Farol</th></tr></thead><tbody><c:forEach items="${items}" var="i"><tr><td>${i.code}</td><td><a href="${pageContext.request.contextPath}/itens-controle/${i.id}">${i.name}</a></td><td>${i.area}</td><td>${i.owner}</td><td>${i.target}</td><td>${i.currentValue}</td><td><span class="status ${i.trafficColor}">${i.trafficColor}</span></td></tr></c:forEach><c:if test="${empty items}"><tr><td class="empty" colspan="7">Nenhum KPI cadastrado. Inicie o acompanhamento cadastrando um indicador.</td></tr></c:if></tbody></table></div></div>
<%@ include file="../common/footer.jsp" %>