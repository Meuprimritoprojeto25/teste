<%@ include file="../common/header.jsp" %>
<div class="breadcrumb">GESTÃO / DESDOBRAMENTOS / NOVO</div><div class="title-line"><div><h1>Novo desdobramento</h1><p class="hint">Associe uma ação corretiva a um KPI industrial.</p></div></div>
<form class="form-panel" method="post" action="${pageContext.request.contextPath}/desdobramentos"><div class="form-grid"><div class="field"><label>Item de controle *</label><select name="controlItem.id" required><option value="">Selecione</option><c:forEach items="${items}" var="i"><option value="${i.id}">${i.code} - ${i.name}</option></c:forEach></select></div><div class="field"><label>Responsável *</label><input name="responsible" required></div><div class="field full"><label>Ação / contramedida *</label><textarea name="action" required></textarea></div><div class="field"><label>Prazo *</label><input type="date" name="dueDate" required></div><div class="field"><label>Status</label><select name="status"><option value="ABERTO">Aberto</option><option value="EM_ANDAMENTO">Em andamento</option><option value="CONCLUIDO">Concluído</option></select></div><div class="field full"><label>Evidência inicial</label><textarea name="evidence"></textarea></div></div><div class="form-actions"><button class="button">Criar plano</button><a class="button secondary" href="${pageContext.request.contextPath}/desdobramentos">Cancelar</a></div></form>
<%@ include file="../common/footer.jsp" %>