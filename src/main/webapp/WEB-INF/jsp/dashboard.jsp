<%@ include file="common/header.jsp" %>
<div class="breadcrumb">INÍCIO / PAINEL GERENCIAL</div><div class="title-line"><div><h1>Painel de desempenho industrial</h1><p class="hint">Visão consolidada da operação e dos indicadores de produção</p></div><a class="button" href="${pageContext.request.contextPath}/relatorios/farol">Gerar relatório</a></div>
<section class="metrics"><div class="metric green"><label>Dentro da meta</label><b>${green}</b><small>Itens em situação verde</small></div><div class="metric yellow"><label>Atenção</label><b>${yellow}</b><small>Itens com desvio controlado</small></div><div class="metric red"><label>Críticos</label><b>${red}</b><small>Demandam ação imediata</small></div><div class="metric"><label>Planos em aberto</label><b>${openActions}</b><small>${expiredTraining} treinamento(s) vencido(s)</small></div></section>
<section class="columns"><div class="panel"><div class="panel-title"><h2>Farol de itens de controle</h2><a href="${pageContext.request.contextPath}/itens-controle">Ver todos</a></div><div class="panel-body"><table><thead><tr><th>Código</th><th>Indicador</th><th>Área</th><th>Leitura</th><th>Situação</th></tr></thead><tbody><c:forEach items="${items}" var="i"><tr><td>${i.code}</td><td><a href="${pageContext.request.contextPath}/itens-controle/${i.id}">${i.name}</a></td><td>${i.area}</td><td>${i.currentValue} / ${i.target}</td><td><span class="dot ${i.trafficColor}"></span>${i.trafficColor}</td></tr></c:forEach><c:if test="${empty items}"><tr><td colspan="5" class="empty">Nenhum item cadastrado. Crie o primeiro item de controle.</td></tr></c:if></tbody></table></div></div><div class="panel"><div class="panel-title"><h2>Distribuição do farol</h2></div><div class="panel-body"><div class="chart"><div style="height:75%;background:#36a66d"><span>${green}</span><i>VERDE</i></div><div style="height:46%;background:#efb02e"><span>${yellow}</span><i>AMARELO</i></div><div style="height:22%;background:#dd5555"><span>${red}</span><i>VERMELHO</i></div></div></div></div></section>
<%@ include file="common/footer.jsp" %>