<%@ include file="../common/header.jsp" %>
<div class="breadcrumb">RELATÓRIOS / R3G</div><div class="title-line"><div><h1>Relatório R3G</h1><p class="hint">Registro gerencial de resultados, gaps e governança.</p></div></div>
<section class="columns"><div class="panel"><div class="panel-title"><h2>Emitir novo R3G</h2></div><div class="panel-body"><form method="post" action="${pageContext.request.contextPath}/r3g"><div class="field"><label>Período *</label><input name="period" placeholder="05/2025" required></div><div class="field" style="margin-top:10px"><label>Área *</label><select name="area"><option>Alto-forno</option><option>Aciaria</option><option>Logística</option><option>Corporativo</option></select></div><div class="field" style="margin-top:10px"><label>Resultados e gaps *</label><textarea name="analysis" required></textarea></div><div class="field" style="margin-top:10px"><label>Decisões e próximos passos *</label><textarea name="decisions" required></textarea></div><div class="form-actions"><button class="button">Gerar R3G</button></div></form></div></div><div class="panel"><div class="panel-title"><h2>Histórico emitido</h2></div><div class="panel-body"><table><thead><tr><th>Relatório</th><th>Período</th><th>Gerado em</th></tr></thead><tbody><c:forEach items="${reports}" var="r"><tr><td>${r.title}</td><td>${r.period}</td><td>${r.generatedAt}</td></tr></c:forEach><c:if test="${empty reports}"><tr><td colspan="3" class="empty">Nenhum R3G emitido.</td></tr></c:if></tbody></table></div></div></section>
<%@ include file="../common/footer.jsp" %>