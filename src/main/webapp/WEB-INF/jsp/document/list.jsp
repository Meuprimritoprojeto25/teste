<%@ include file="../common/header.jsp" %>
<div class="breadcrumb">GESTÃO DOCUMENTAL / DOCUMENTOS</div><div class="title-line"><div><h1>Documentos gerenciais</h1><p class="hint">Criação, revisão e edição de procedimentos e relatórios internos.</p></div><a class="button" href="${pageContext.request.contextPath}/documentos/novo">Novo documento</a></div>
<div class="panel"><div class="panel-body"><table><thead><tr><th>Título</th><th>Tipo</th><th>Revisão</th><th>Autor</th><th>Última alteração</th><th></th></tr></thead><tbody><c:forEach items="${documents}" var="d"><tr><td>${d.title}</td><td>${d.type}</td><td>${d.revision}</td><td>${d.author}</td><td>${d.changedAt}</td><td><a class="button secondary" href="${pageContext.request.contextPath}/documentos/${d.id}/editar">Editar</a> <a href="${pageContext.request.contextPath}/documentos/${d.id}/pdf">PDF</a> <a href="${pageContext.request.contextPath}/documentos/${d.id}/word">Word</a></td></tr></c:forEach><c:if test="${empty documents}"><tr><td class="empty" colspan="6">Nenhum documento criado.</td></tr></c:if></tbody></table></div></div>
