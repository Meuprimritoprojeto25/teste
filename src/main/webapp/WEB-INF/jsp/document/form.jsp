<%@ include file="../common/header.jsp" %>
<div class="breadcrumb">GESTÃO DOCUMENTAL / EDIÇÃO</div><div class="title-line"><div><h1>Editor de documento</h1><p class="hint">Registre conteúdo, revisão e responsável pela publicação.</p></div></div>
<form class="form-panel" method="post" action="${pageContext.request.contextPath}/documentos"><input type="hidden" name="id" value="${document.id}"><div class="form-grid"><div class="field"><label>Título *</label><input name="title" value="${document.title}" required></div><div class="field"><label>Tipo</label><select name="type"><option value="PROCEDIMENTO">Procedimento</option><option value="INSTRUCAO_TRABALHO">Instrução de trabalho</option><option value="RELATORIO">Relatório</option><option value="ATA">Ata</option></select></div><div class="field"><label>Revisão</label><input name="revision" value="${document.revision}" placeholder="1.0"></div><div class="field"><label>Autor *</label><input name="author" value="${document.author}" required></div><div class="field full"><label>Conteúdo do documento *</label><textarea name="content" required><c:out value="${document.content}"/></textarea></div></div><div class="form-actions"><button class="button">Salvar revisão</button><a class="button secondary" href="${pageContext.request.contextPath}/documentos">Cancelar</a></div></form>
<%@ include file="../common/footer.jsp" %>