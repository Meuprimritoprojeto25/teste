<%@ include file="../common/header.jsp" %>
<div class="breadcrumb">PESSOAS / TREINAMENTO DE MOTORISTAS</div><div class="title-line"><div><h1>Treinamento de motoristas</h1><p class="hint">Controle de habilitações, cursos operacionais e validade.</p></div><a class="button" href="${pageContext.request.contextPath}/treinamentos/novo">Registrar treinamento</a></div>
<c:if test="${expired > 0}"><div class="note">Atenção: existem ${expired} treinamento(s) com validade vencida. Avalie o bloqueio da operação dos motoristas.</div></c:if><div class="panel" style="margin-top:16px"><div class="panel-body"><table><thead><tr><th>Motorista</th><th>Veículo</th><th>Curso / certificação</th><th>Validade</th><th>Situação</th></tr></thead><tbody><c:forEach items="${trainings}" var="t"><tr><td>${t.driverName}</td><td>${t.vehicle}</td><td>${t.course}</td><td>${t.expiration}</td><td><span class="status ${t.status}">${t.status}</span></td></tr></c:forEach><c:if test="${empty trainings}"><tr><td class="empty" colspan="5">Nenhum treinamento registrado.</td></tr></c:if></tbody></table></div></div>
