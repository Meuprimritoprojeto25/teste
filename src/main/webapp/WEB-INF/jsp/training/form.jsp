<%@ include file="../common/header.jsp" %>
<div class="breadcrumb">PESSOAS / TREINAMENTOS / NOVO</div><div class="title-line"><div><h1>Registrar treinamento</h1><p class="hint">Cadastre a certificação necessária para condução industrial.</p></div></div>
<form class="form-panel" method="post" action="${pageContext.request.contextPath}/treinamentos"><div class="form-grid"><div class="field"><label>Nome do motorista *</label><input name="driverName" required></div><div class="field"><label>Veículo / equipamento</label><input name="vehicle" placeholder="Caminhão fora de estrada"></div><div class="field"><label>Curso ou certificação *</label><input name="course" required></div><div class="field"><label>Data de validade *</label><input type="date" name="expiration" required></div><div class="field"><label>Situação</label><select name="status"><option value="VIGENTE">Vigente</option><option value="PENDENTE">Pendente</option></select></div></div><div class="form-actions"><button class="button">Salvar treinamento</button><a class="button secondary" href="${pageContext.request.contextPath}/treinamentos">Cancelar</a></div></form>
